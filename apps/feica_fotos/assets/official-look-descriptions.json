    "greg": {
      "name": "Greg Williams",
      "name_locale": "en",
      "description": "这一Artist Look由Greg Williams与Leica合作研发，旨在让每张照片都展现真实和亲切氛围。它具有电影般的质感，让人想起Tri-X 400的复古扫描画质。",
      "locale": "zh-Hans",
      "resource_key": "LeicaLooks.LUT.GW.Info",
      "source_path": "LeicaStrings_LeicaStringsShared.bundle/zh-Hans.lproj/Shared.strings",
      "source_sha256": "75b9ddf854d80b1888872cba366e91158cbe0d5933525169d4160d0b8b82b71b",
      "source_family": "LeicaStrings.Shared.LUT.Info",
      "name_resource_key": "leica_looks_item_greg_williams_title",
      "name_source_path": "Modules_Localization.bundle/en.lproj/Localizable.strings",
      "name_source_sha256": "5b8e77f7231488e5cc3e6dddbe3ee1c654cc0f6db8dae4180448669b42bbcb21",
      "name_quoted_in_description": null,
      "extended_description": "这一Artist Look由Greg Williams与Leica合作研发，旨在让每张照片都展现真实和亲切氛围。它具有电影般的质感，让人想起Tri-X 400的复古扫描画质。 \n\n该外观配有对比度滑块，可针对强烈日光至阴沉多云等不同光照条件进行精细调节。它刻意避免过度锐化或夸张的曲线，最大限度减少干扰并聚焦于真情实感，让照片定格的精彩瞬间静静闪耀温柔光芒。 \n\n一抹微妙暖调让人联想起经典的溴化银印相，为作品赋予一种匠心独造的永恒质感。",
      "extended_resource_key": "LeicaLooks.LUT.GW.ExtendedInfo",
      "local_editor_resource_key": "LeicaLooks.LUT.GW.Info",
      "video_verbatim_match": null,
      "resource_token": "GW"
    },
    "hundred_years": {
      "name": null,
      "name_locale": null,
      "description": "这种单色调胶片预设还原真实颗粒质感，重现20世纪早期摄影艺术的优雅韵味。共庆全球首款量产35mm胶片相机Leica I Model A（1925年）的百年传奇。",
      "locale": "zh-Hans",
      "resource_key": "LeicaLooks.LUT.HundredYears.Info",
